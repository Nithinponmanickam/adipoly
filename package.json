{
  "name": "adipoly",
  "version": "0.1.0",
  "private": true,
  "description": "ADIPOLY - Original Browser-Based Multiplayer Business Strategy Game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"blue,magenta\" \"npm run dev -w @adipoly/server\" \"npm run dev -w @adipoly/web\"",
    "dev:server": "npm run dev -w @adipoly/server",
    "dev:web": "npm run dev -w @adipoly/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "node -e \"const fs=require('fs'); if(fs.existsSync('node_modules/@rollup/wasm-node/dist')){fs.copyFileSync('node_modules/@rollup/wasm-node/dist/native.js','node_modules/rollup/dist/native.js'); fs.cpSync('node_modules/@rollup/wasm-node/dist/wasm-node','node_modules/rollup/dist/wasm-node',{recursive:true});}\""
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.64.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.64.1"
  }
}
